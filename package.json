{
  "name": "fairshift",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12 <25"
  },
  "scripts": {
    "dev": "concurrently -k \"tsx watch --env-file-if-exists=.env server/src/index.ts\" \"vite --host 0.0.0.0\"",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node --env-file-if-exists=.env dist/server/src/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "emulators": "tsx scripts/emulators.ts",
    "test:integration": "tsx scripts/emulators.ts test",
    "test:browser": "playwright test",
    "dev:local": "tsx scripts/dev-local.ts"
  },
  "dependencies": {
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "firebase": "13.1.0",
    "firebase-admin": "14.5.0",
    "helmet": "8.3.0",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "eslint": "10.13.0",
    "firebase-tools": "15.34.1",
    "prettier": "3.9.10",
    "supertest": "7.3.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.6"
  }
}
