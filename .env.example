# Public Firebase WEB configuration used by Vite (these identifiers are not private keys).
VITE_FIREBASE_API_KEY=replace_with_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=replace_with_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=replace_with_project_id
VITE_FIREBASE_APP_ID=replace_with_firebase_web_app_id

# Backend: Google Cloud service identity / ADC is used for Firestore in Cloud Run.
# Do not set GOOGLE_APPLICATION_CREDENTIALS to a committed JSON key.
GCLOUD_PROJECT=replace_with_project_id
PORT=8080
NODE_ENV=development
